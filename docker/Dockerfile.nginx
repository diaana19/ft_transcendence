# Edge reverse proxy: TLS termination + routing to frontend and backend.
FROM docker.io/library/nginx:alpine

# Self-signed certificate for local HTTPS (dev / school evaluation). Generated at
# build time so nothing sensitive is committed; mount real certs over
# /etc/nginx/certs for production.
RUN apk add --no-cache openssl \
 && mkdir -p /etc/ssl/private /etc/ssl/certs \
 && openssl req -x509 -sha256 -nodes -days 365 \
      -newkey rsa:2048 \
      -keyout /etc/ssl/private/ft_transcendence.42.fr.key \
      -out    /etc/ssl/certs/ft_transcendence.42.fr.crt \
      -subj "/C=FR/ST=Ile-de-France/L=Paris/O=42/OU=ft_transcendence/CN=ft_transcendence.42.fr" \
      -addext "subjectAltName=DNS:ft_transcendence.42.fr,DNS:localhost,IP:127.0.0.1"

COPY docker/proxy.nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 443
