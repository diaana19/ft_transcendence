# Edge reverse proxy: TLS termination + routing to frontend and backend.
FROM docker.io/library/nginx:alpine

# The TLS certificate is NOT baked into the image — it is generated once on the
# host (`make certs`) and bind-mounted read-only at /etc/nginx/certs (see
# infra/docker-compose.yml). Generating per-build would mint a new cert on every
# rebuild, invalidating any browser trust exception; a mounted, stable cert lets
# the one-time "accept the risk" persist. Mount real certs there for production.

COPY docker/proxy.nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 443
