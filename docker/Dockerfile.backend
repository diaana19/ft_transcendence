FROM docker.io/library/golang:1.25-alpine AS builder

WORKDIR /app

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ .

# Generate the OpenAPI spec (backend/docs) on every image build. The spec is a
# build artifact (git-ignored), so it is regenerated here rather than committed.
# --quiet silences swag's cosmetic warnings (e.g. "no Go files in /app" — the
# module root holds no .go files per the project layout); the spec is identical.
RUN go tool swag init -g cmd/server/main.go -o docs --parseDependency --parseInternal --quiet

RUN go build -o server ./cmd/server/main.go

FROM docker.io/library/alpine:latest

WORKDIR /root/

COPY --from=builder /app/server .
COPY --from=builder /app/uploads ./uploads

EXPOSE 8080

CMD ["./server"]
