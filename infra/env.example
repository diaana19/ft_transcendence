# ─────────────────────────────────────────────────────────────
# Local development environment for the ft_transcendence stack.
# Consumed by: docker compose (infra/docker-compose.yml) and
# host-side tooling via mise (mise.toml -> _.file = infra/.env).
# Fixed topology values (DB_HOST/DB_PORT, REDIS_*) live directly
# in docker-compose.yml, not here. Do not commit real secrets.
# ─────────────────────────────────────────────────────────────

# ---- Server / ports (configurable) ----
# The proxy is the public entrypoint (HTTP redirects to HTTPS). API_PORT is the
# backend's direct/dev port; the frontend is internal (reached via the proxy).
HTTP_PORT=80
HTTPS_PORT=443
API_PORT=8000
GIN_MODE=debug
FRONTEND_URL=https://localhost

# ---- Rate limiting ----
# Max requests per client IP per minute (defaults to 20 if unset).
RATE_LIMIT_MAX=20

# ---- Database credentials (Postgres) ----
DB_USER=app
DB_PASSWORD=app
DB_NAME=app_db

# ---- Auth ----
JWT_SECRET=dev-only-change-me-0123456789abcdef

# ---- GitHub OAuth (fill in to enable GitHub login) ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=https://localhost/api/auth/oauth/github/callback
