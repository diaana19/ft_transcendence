# ─────────────────────────────────────────────────────────────
# Local development environment for the ft_transcendence stack.
# Consumed by: docker compose (infra/docker-compose.yml) and
# host-side tooling via mise (mise.toml -> _.file = infra/.env).
# Fixed topology values (DB_HOST/DB_PORT, REDIS_*) live directly
# in docker-compose.yml, not here. Do not commit real secrets.
# ─────────────────────────────────────────────────────────────

# ---- App ----
# Public home address (used by the backend for OAuth redirects, etc.). Ports are fixed
# in infra/docker-compose.yml (proxy 3000:443, backend internal 8080), and the per-IP
# rate limit defaults to 20 req/min in code.
FT_TRANSCENDENCE_URL=https://localhost:3000

# ---- Database credentials (Postgres) ----
DB_USER=app
DB_PASSWORD=app
DB_NAME=app_db

# ---- Auth ----
JWT_SECRET=dev-only-change-me-0123456789abcdef

# ---- GitHub OAuth (fill in to enable GitHub login) ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=https://localhost:3000/api/auth/oauth/github/callback
