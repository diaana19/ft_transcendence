# ---- App ----
# Public home address (used by the backend for OAuth redirects, etc.). Ports are fixed
# in infra/docker-compose.yml (proxy 3000:443, backend internal 8080).
FT_TRANSCENDENCE_URL=https://localhost:3000

# Per-IP rate limit for /auth endpoints, in requests/minute (defaults to 20 in code).
# `make seed` reads this same value to pace its register/login calls — raise it here to
# seed large datasets faster, then `make up` to apply, e.g. RATE_LIMIT_MAX=1000.
RATE_LIMIT_MAX=100

# ---- Database credentials (Postgres) ----
DB_USER=
DB_PASSWORD=
DB_NAME=

# ---- Auth ----
JWT_SECRET=

# ---- GitHub OAuth (fill in to enable GitHub login) ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=

# ---- Email / SMTP (Hostinger) ----
# Consumed by internal/services/mail_service.go. Port 587 uses STARTTLS, which is
# what net/smtp negotiates automatically. SMTP_FROM defaults to SMTP_USER if unset.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
